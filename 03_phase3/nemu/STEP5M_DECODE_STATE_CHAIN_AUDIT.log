   192	_Noreturn void longjmp_context(int cause) {
   193	  Loge("Longjmp to jbuf_exec with cause: %i", cause);
   194	  if (context_idx < 0) {
   195	    panic("Unexcepted exeception context idx = %d", context_idx);
   196	  }
   197	  longjmp(context_stack[context_idx], cause);
   198	}
   199	
   200	_Noreturn void longjmp_exception(int ex_cause) {
   201	  if (context_idx == 0) {
   202	    // context_idx == 0 means only the execute loop context saved.
   203	  #ifdef CONFIG_GUIDED_EXEC
   204	    cpu.guided_exec = false;
   205	  #endif
   206	    g_ex_cause = ex_cause;
   207	    Loge("longjmp_context(NEMU_EXEC_EXCEPTION)");
   208	    longjmp_context(NEMU_EXEC_EXCEPTION);
   209	  } else {
   210	    // For other condition, we should pass parameter ex_cause to longjmp
   211	    longjmp_context(ex_cause);
   212	  }
   213	}
