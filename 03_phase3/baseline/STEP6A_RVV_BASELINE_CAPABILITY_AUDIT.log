===== 5. CREATE TEMPORARY ASSEMBLER PROBE =====
PROBE_SOURCE:
    .text
    .align 2
    .globl cie2026_rvv_baseline_probe

cie2026_rvv_baseline_probe:
    # Exactly eight signed INT8 source elements.
    # mf2 makes the widening INT16 result occupy one full vector register.
    vsetivli t0, 8, e8, mf2, ta, ma

    vle8.v      v8, (a0)
    vle8.v      v9, (a1)

    # signed INT8 x signed INT8 -> signed INT16
    vwmul.vv    v10, v8, v9

    # Reinterpret the eight INT16 products as SEW=16, LMUL=1.
    vsetivli t0, 8, e16, m1, ta, ma

    # Zero widening-reduction seed.
    vmv.v.i     v12, 0

    # signed INT16 reduction -> signed INT32 accumulator/result
    vwredsum.vs v14, v10, v12

    # Store only the resulting low 32-bit scalar element.
    vsetivli t0, 1, e32, m1, ta, ma
    vse32.v     v14, (a2)

    ret

