+/*
+ * CIE2026 custom-0 vdot.vv reference semantics.
+ *
+ * Frozen XiangShan Phase2 behavior:
+ *   - VLEN = 128
+ *   - SEW must be e8
+ *   - use only source bytes 0..7
+ *   - signed INT8 x signed INT8
+ *   - signed INT32 sum
+ *   - vd[31:0] = result bit pattern
+ *   - vd[127:32] = 0
+ *
+ * The arithmetic term count is fixed at 8 and does not follow vl.
+ */
+def_EHelper(cie2026_vdot_vv) {
+  require_vector(true);
+
+  // NEMU encodes e8 as vsew == 0.
+  if (vtype->vsew != 0) {
+    longjmp_exception(EX_II);
+  }
+
+  int32_t sum = 0;
+
+  for (int i = 0; i < 8; i++) {
+    int32_t a = (int8_t)vreg_b(id_src->reg, i);
+    int32_t b = (int8_t)vreg_b(id_src2->reg, i);
+
+    sum += a * b;
+  }
+
+  /*
+   * Store exactly the frozen RTL architectural layout:
+   *
+   *   bits 31:0   = signed INT32 bit pattern
+   *   bits 127:32 = zero
+   */
+  vreg_l(id_dest->reg, 0) = (uint64_t)(uint32_t)sum;
+  vreg_l(id_dest->reg, 1) = 0;
+
+  vp_set_dirty();
+}
+
 def_EHelper(vwsmaccu) {
   longjmp_exception(EX_II);
 }

