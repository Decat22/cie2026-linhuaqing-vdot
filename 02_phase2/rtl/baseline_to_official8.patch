+  // ==========================================================
+  // CIE2026 vdot.vv datapath
+  //
+  // Official semantics for VLEN = 128, SEW = 8:
+  //   use only the LOW 8 signed INT8 elements from vs1
+  //   use only the LOW 8 signed INT8 elements from vs2
+  //
+  // result = sum(vs1[i] * vs2[i]), i = 0..7
+  //
+  // Source bytes [127:64] are intentionally ignored.
+  // The maximum positive result is 8 * (-128 * -128) = 131072,
+  // which requires 19 signed bits. The architectural result is
+  // written as signed INT32 in vd[31:0], with vd[127:32] cleared.
+  //
+  // A balanced reduction tree is used instead of a serial chain.
+  // ==========================================================
+
+  private val vdotProducts = (0 until 8).map { i =>
+    val a = vs1(8 * i + 7, 8 * i).asSInt
+    val b = vs2(8 * i + 7, 8 * i).asSInt
+    a * b
+  }
+
+  private val vdotSumL1 = (0 until 4).map { i =>
+    vdotProducts(2 * i) +& vdotProducts(2 * i + 1)
+  }
+
+  private val vdotSumL2 = (0 until 2).map { i =>
+    vdotSumL1(2 * i) +& vdotSumL1(2 * i + 1)
+  }
+
+  private val vdotSum = vdotSumL2(0) +& vdotSumL2(1)
+
+  private val vdotSum32 = Wire(SInt(32.W))
+  vdotSum32 := vdotSum
+
+  private val vdotComb = Cat(
+    0.U(96.W),
+    vdotSum32.asUInt
+  )
+
+  // VimacCfg has CertainLatency(2).  Keep the custom result aligned
+  // with ctrlVec.last / io.out.valid.
+  private val vdotResult = SNReg(vdotComb, latency)
+
   /**
     * [[typeMod]]'s in connection
     */
